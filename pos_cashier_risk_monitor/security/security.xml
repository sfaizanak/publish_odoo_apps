<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_pos_risk_monitor" model="res.groups.privilege">
        <field name="name">POS Risk Monitor</field><field name="description">POS Risk Monitor</field>
        <field name="sequence">25</field><field name="category_id" ref="base.module_category_sales"/>
    </record>
    <record id="group_pos_risk_user" model="res.groups">
        <field name="name">Risk Monitoring User</field><field name="privilege_id" ref="module_category_pos_risk_monitor"/>
    </record>
    <record id="group_pos_risk_manager" model="res.groups">
        <field name="name">Risk Manager</field><field name="privilege_id" ref="module_category_pos_risk_monitor"/>
        <field name="implied_ids" eval="[(4, ref('group_pos_risk_user'))]"/>
    </record>
    <record id="group_pos_risk_admin" model="res.groups">
        <field name="name">Risk Administrator</field><field name="privilege_id" ref="module_category_pos_risk_monitor"/>
        <field name="implied_ids" eval="[(4, ref('group_pos_risk_manager'))]"/>
    </record>
    <record id="rule_pos_risk_rule_company" model="ir.rule">
        <field name="name">Risk rules: allowed companies</field><field name="model_id" ref="model_pos_risk_rule"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_pos_risk_user'))]"/>
    </record>
    <record id="rule_pos_risk_case_user_assigned" model="ir.rule">
        <field name="name">Risk cases: assigned user</field><field name="model_id" ref="model_pos_risk_case"/>
        <field name="domain_force">[('company_id', 'in', company_ids), ('assigned_user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_pos_risk_user'))]"/>
    </record>
    <record id="rule_pos_risk_case_manager_company" model="ir.rule">
        <field name="name">Risk cases: manager company access</field><field name="model_id" ref="model_pos_risk_case"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_pos_risk_manager'))]"/>
    </record>
    <record id="rule_pos_risk_case_reason_user_assigned" model="ir.rule">
        <field name="name">Risk case reasons: assigned cases</field><field name="model_id" ref="model_pos_risk_case_reason"/>
        <field name="domain_force">[('company_id', 'in', company_ids), ('case_id.assigned_user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_pos_risk_user'))]"/>
    </record>
    <record id="rule_pos_risk_case_reason_manager_company" model="ir.rule">
        <field name="name">Risk case reasons: manager company access</field><field name="model_id" ref="model_pos_risk_case_reason"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_pos_risk_manager'))]"/>
    </record>
    <record id="rule_pos_risk_event_company" model="ir.rule">
        <field name="name">Risk events: allowed companies</field><field name="model_id" ref="model_pos_risk_event"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_pos_risk_user'))]"/>
    </record>
    <record id="rule_pos_cashier_baseline_company" model="ir.rule">
        <field name="name">Cashier baselines: allowed companies</field>
        <field name="model_id" ref="model_pos_cashier_baseline"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_pos_risk_user'))]"/>
    </record>
    <record id="rule_pos_risk_ml_model_company" model="ir.rule">
        <field name="name">ML models: allowed companies</field>
        <field name="model_id" ref="model_pos_risk_ml_model"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_pos_risk_user'))]"/>
    </record>
    <record id="rule_pos_risk_evaluation_company" model="ir.rule">
        <field name="name">Risk evaluations: allowed companies</field>
        <field name="model_id" ref="model_pos_risk_evaluation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_pos_risk_user'))]"/>
    </record>
    <record id="rule_pos_risk_evaluation_scenario_company" model="ir.rule">
        <field name="name">Risk evaluation scenarios: allowed companies</field>
        <field name="model_id" ref="model_pos_risk_evaluation_scenario"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_pos_risk_user'))]"/>
    </record>
</odoo>
