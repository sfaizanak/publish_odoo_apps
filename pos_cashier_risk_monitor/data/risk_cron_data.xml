<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_pos_risk_process_pending" model="ir.cron">
        <field name="name">POS Risk: Analyze Pending Orders</field>
        <field name="model_id" ref="point_of_sale.model_pos_order"/>
        <field name="state">code</field>
        <field name="code">model._cron_process_pending_risk_orders(limit=100)</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
    <record id="ir_cron_pos_risk_recalculate_baselines" model="ir.cron">
        <field name="name">POS Risk: Recalculate Behavioural Baselines</field>
        <field name="model_id" ref="model_pos_cashier_baseline"/>
        <field name="state">code</field>
        <field name="code">model._cron_recalculate_baselines()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
    <record id="ir_cron_pos_risk_train_models" model="ir.cron">
        <field name="name">POS Risk: Train Isolation Forest Models</field>
        <field name="model_id" ref="model_pos_risk_ml_model"/>
        <field name="state">code</field>
        <field name="code">model._cron_train_models()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <field name="active">True</field>
    </record>
</odoo>
