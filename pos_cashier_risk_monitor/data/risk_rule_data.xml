<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
<record id="rule_high_discount" model="pos.risk.rule"><field name="name">High Discount</field><field name="code">HIGH_DISCOUNT</field><field name="category">discount</field><field name="scope">line</field><field name="operator">gte</field><field name="threshold_value">25</field><field name="severity_score">60</field><field name="risk_weight">1</field><field name="case_classification">policy_violation</field><field name="description">Maximum line discount is at least 25%.</field><field name="recommended_action">Verify manager authorization and business context.</field></record>
<record id="rule_negative_margin" model="pos.risk.rule"><field name="name">Negative Margin</field><field name="code">NEGATIVE_MARGIN</field><field name="category">discount</field><field name="scope">line</field><field name="operator">lt</field><field name="threshold_value">0</field><field name="severity_score">85</field><field name="risk_weight">1</field><field name="case_classification">requires_review</field><field name="description">Final selling value is below the available cost reference.</field><field name="recommended_action">Confirm cost data and authorization for the sale.</field></record>
<record id="rule_drastic_price_decrease" model="pos.risk.rule"><field name="name">Drastic Price Decrease</field><field name="code">DRASTIC_PRICE_DECREASE</field><field name="category">price_override</field><field name="scope">line</field><field name="operator">gte</field><field name="threshold_value">30</field><field name="severity_score">75</field><field name="risk_weight">1</field><field name="case_classification">possible_error</field><field name="description">Manual price decrease is at least 30%.</field><field name="recommended_action">Confirm the original applicable price and cashier reason.</field></record>
<record id="rule_drastic_price_increase" model="pos.risk.rule"><field name="name">Drastic Price Increase</field><field name="code">DRASTIC_PRICE_INCREASE</field><field name="category">price_override</field><field name="scope">line</field><field name="operator">gte</field><field name="threshold_value">30</field><field name="severity_score">55</field><field name="risk_weight">1</field><field name="case_classification">requires_review</field><field name="description">Manual price increase is at least 30%.</field><field name="recommended_action">Confirm that the override was intentional and authorized.</field></record>
<record id="rule_excessive_line_deletion" model="pos.risk.rule"><field name="name">Excessive Line Deletion</field><field name="code">EXCESSIVE_LINE_DELETION</field><field name="category">deletion</field><field name="scope">order</field><field name="operator">gt</field><field name="threshold_value">3</field><field name="severity_score">65</field><field name="risk_weight">1</field><field name="case_classification">possible_error</field><field name="description">More than three order lines were deleted.</field><field name="recommended_action">Review deleted products and cashier explanation.</field></record>
<record id="rule_high_value_line_deletion" model="pos.risk.rule"><field name="name">High-Value Line Deletion</field><field name="code">HIGH_VALUE_LINE_DELETION</field><field name="category">deletion</field><field name="scope">order</field><field name="operator">gt</field><field name="threshold_value">0</field><field name="minimum_amount">100</field><field name="severity_score">75</field><field name="risk_weight">1</field><field name="case_classification">requires_review</field><field name="description">A deleted-line event has material financial value.</field><field name="recommended_action">Review the deleted line value and authorization.</field></record>
<record id="rule_unlinked_refund" model="pos.risk.rule"><field name="name">Unlinked Refund</field><field name="code">UNLINKED_REFUND</field><field name="category">refund</field><field name="scope">order</field><field name="operator">gt</field><field name="threshold_value">0</field><field name="severity_score">90</field><field name="risk_weight">1</field><field name="case_classification">fraud_risk</field><field name="description">A refund was received without a linked original line.</field><field name="recommended_action">Verify the original receipt and refund authorization.</field></record>
<record id="rule_high_value_refund" model="pos.risk.rule"><field name="name">High-Value Refund</field><field name="code">HIGH_VALUE_REFUND</field><field name="category">refund</field><field name="scope">order</field><field name="operator">gte</field><field name="threshold_value">500</field><field name="severity_score">70</field><field name="risk_weight">1</field><field name="case_classification">requires_review</field><field name="description">Refund amount exceeds the configured high-value threshold.</field><field name="recommended_action">Verify receipt, customer context and approval.</field></record>
<record id="rule_repeated_refunds" model="pos.risk.rule"><field name="name">Repeated Refunds</field><field name="code">REPEATED_REFUNDS</field><field name="category">refund</field><field name="scope">order</field><field name="operator">gte</field><field name="threshold_value">3</field><field name="window_minutes">60</field><field name="severity_score">80</field><field name="risk_weight">1</field><field name="case_classification">behavioural_anomaly</field><field name="description">At least three refunds occurred within the configured window.</field><field name="recommended_action">Review recent refund activity for the cashier.</field></record>
<record id="rule_combined_override_delete" model="pos.risk.rule"><field name="name">Combined Override and Deletion</field><field name="code">COMBINED_OVERRIDE_DELETE</field><field name="category">combined</field><field name="scope">order</field><field name="operator">gte</field><field name="threshold_value">2</field><field name="severity_score">85</field><field name="risk_weight">1</field><field name="case_classification">fraud_risk</field><field name="description">An order contains both a manual override and a deleted line.</field><field name="recommended_action">Review the complete order history and authorization.</field></record>
</odoo>
