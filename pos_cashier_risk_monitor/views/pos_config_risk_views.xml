<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_pos_config_risk_list" model="ir.ui.view">
            <field name="name">pos.config.risk.list</field>
            <field name="model">pos.config</field>
            <field name="inherit_id" ref="point_of_sale.view_pos_config_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//list" position="inside">
                    <field name="pos_risk_monitoring_enabled"/>
                </xpath>
            </field>
        </record>

        <record id="view_pos_config_risk_form" model="ir.ui.view">
            <field name="name">pos.config.risk.form</field>
            <field name="model">pos.config</field>
            <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@id='title']" position="after">
                    <label for="pos_risk_monitoring_enabled"/>
                    <field name="pos_risk_monitoring_enabled" string="Enable Risk Monitoring"/>
                    <div class="alert alert-info" role="alert">
                        Enabling this flag records the setting only.
                        No detection, scoring or case creation runs yet —
                        those arrive in later implementation phases.
                    </div>
                </xpath>
            </field>
        </record>

        <record id="action_pos_config_risk" model="ir.actions.act_window">
            <field name="name">Risk Monitoring Settings</field>
            <field name="res_model">pos.config</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
